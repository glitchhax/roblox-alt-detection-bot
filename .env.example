# Discord Bot Token - Get from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: Guild ID for faster slash command registration during development
# If not set, commands register globally (can take up to 1 hour)
GUILD_ID=

# Optional: Restrict /restart and /send to specific role IDs (comma-separated)
ADMIN_ROLE_IDS=
